# =============================================================================
#  Generated by Trance AutoDJ — every edit here is overwritten.
#  Change config.yaml (or the dashboard) instead.
#
#  Generated: {{ generated_at }}
# =============================================================================

settings.log.level.set({{ log_level }})
settings.log.stdout.set(true)
settings.log.file.set(false)

# Telnet is the control surface: the dashboard uses it to reload the playlist
# and to ask what is playing, without restarting the broadcast.
settings.server.telnet.set(true)
settings.server.telnet.bind_addr.set("{{ telnet_host }}")
settings.server.telnet.port.set({{ telnet_port }})

# -----------------------------------------------------------------------------
#  Sources
# -----------------------------------------------------------------------------

# reload_mode="watch" is the hot reload: writing a new active.m3u is enough,
# the broadcast never stops.
main = playlist(
  id="main",
  mode="{{ mode }}",
  reload_mode="watch",
  reload=1,
  mime_type="audio/mpegurl",
{% if beat_align_cue_in %}
  # Each entry may carry liq_cue_in: the offset of its first beat, so the
  # track starts on the grid instead of wherever the file happens to begin.
  cue_in_metadata="liq_cue_in",
{% endif %}
  "{{ playlist_file }}"
)

{% if safe_track %}
# Second line of defence: one known-good file.
safety = single(id="safety", "{{ safe_track }}")
{% else %}
# No safe track configured, so the second line of defence is silence rather
# than nothing: something must always be on air.
#
# duration=-1. means "forever", and it is load-bearing. With duration=0. this
# source produces an unbroken stream of zero-length tracks: Liquidsoap starts
# a crossfade for each one, the cross buffer counter runs into the thousands
# within minutes, the clock falls seconds behind ("we must catchup 16.83
# seconds"), and the mount serves -91 dB. Worse, the station never comes back
# on its own once it lands here, because the machine is too busy churning
# empty tracks to notice that the playlist has music again. Emptying the
# library for a moment is enough to trigger it.
safety = blank(id="safety", duration=-1.)
{% endif %}

# The audio must never stop. track_sensitive=false lets the fallback cut in
# mid-track the instant the playlist fails, instead of waiting for a track
# boundary that will never arrive.
radio = fallback(
  id="radio",
  track_sensitive=false,
  [main, safety]
)

# -----------------------------------------------------------------------------
#  Loudness
# -----------------------------------------------------------------------------
{% if loudness_enabled %}
# ReplayGain tags when the file has them, computed on the fly when it does not.
# `replaygain` is deprecated in 2.4 in favour of `normalize_track_gain`.
#
# Per-track gain belongs here, before the crossfade, so that both sides of a
# transition are already matched to each other when they overlap.
enable_replaygain_metadata()
radio = normalize_track_gain(radio)
{% endif %}

# -----------------------------------------------------------------------------
#  Crossfade — the sound of the station
# -----------------------------------------------------------------------------
#
#  Liquidsoap 2.4 dropped `smart_crossfade` and its `crossfade` takes no curve
#  arguments, so the transition is written by hand with `cross`. That is not a
#  workaround: it is the only way to get the logarithmic fades this station
#  wants, and it also lets short tracks skip the overlap entirely.

# The transition record carries metadata, not a duration accessor, so the
# length comes from the "duration" tag. A file with no tag is assumed long.
def track_seconds(m) =
  string.to_float(default=9999., m["duration"])
end

# A source that is always ready, whatever happens upstream. This has to be the
# last thing before the crossfade: `cross` rejects a fallible source outright,
# and every operator between here and there could reintroduce fallibility.
radio = mksafe(radio)

{% if beat_aligned %}
# With beat alignment on, each track carries its own crossfade length —
# a whole number of bars at its measured tempo, written into the playlist by
# the dashboard. Fall back to the configured default for anything unmeasured.
def crossfade_seconds(m) =
  string.to_float(default={{ duration }}, m["liq_cross_duration"])
end
{% else %}
def crossfade_seconds(_) =
  {{ duration }}
end
{% endif %}

def trance_transition(a, b) =
  # A track shorter than the crossfade would be swallowed by it. Below the
  # minimum, cut cleanly instead.
  if
    track_seconds(a.metadata) < {{ minimum_track }}
  or
    track_seconds(b.metadata) < {{ minimum_track }}
  then
    log(level=3, "transition: track too short to overlap, cutting")
    sequence([a.source, b.source])
  else
    # The shorter of the two sides wins: fading out over eight bars while
    # fading in over four would leave a hole in the middle.
    seconds = min(crossfade_seconds(a.metadata), crossfade_seconds(b.metadata))
    log(
      level=4,
      "transition: #{seconds}s, out #{a.metadata['bpm']} BPM -> in #{b.metadata['bpm']} BPM"
    )
    add(
      normalize=false,
      [
        fade.out(type="{{ fade_out_curve }}", duration=seconds, a.source),
        fade.in(type="{{ fade_in_curve }}", duration=seconds, b.source)
      ]
    )
  end
end

radio = cross(
  id="crossfade",
  # How much audio is buffered from each side to build the transition.
  duration={{ duration }},
{% if beat_aligned %}
  # A track may ask for a longer overlap than the default. Without this the
  # buffer would be too short and the fade would be truncated to fit.
  override_duration="liq_cross_duration",
{% endif %}
  # Window used to measure the power of both sides; this is what makes the
  # operator loudness-aware rather than blindly symmetric.
  width={{ width }},
  trance_transition,
  radio
)

# ...and again on the way out. `cross` returns a *fallible* source even when
# its input was infallible, because a transition can end. `output.icecast`
# refuses a fallible source, and the error it produces points at the `cross`
# call — where the value was created — not at the output that rejected it,
# which is why this took a while to find. Both wrappers are load-bearing.
radio = mksafe(radio)

{% if loudness_enabled %}
# -----------------------------------------------------------------------------
#  Loudness, part two — AFTER the crossfade, and that is not a matter of taste
# -----------------------------------------------------------------------------
#
#  `normalize` upstream of `cross` leaks. Measured over 30 minutes, identical
#  scripts differing only in this order:
#
#    normalize before cross   175 MB -> 872 MB, 0.08 -> 0.38 cores, still climbing
#    normalize after cross    166 MB -> 191 MB, 0.08 cores, flat
#
#  Left long enough the first one reaches ~2 GB and pins a whole core, which is
#  the end of a 24/7 broadcast. Neither operator leaks on its own; it is the
#  pair. Putting the normaliser last is also the more defensible signal chain:
#  what we are levelling is the broadcast, not each track before it is mixed.
#
#  Bring the result to the target. YouTube normalises to -14 LUFS; matching it
#  means they do not re-process our audio.
radio = normalize(
  id="loudness",
  target={{ target_lufs }},
  window=3.,
  radio
)

# `normalize` is infallible given an infallible input, but the chain above has
# taught us not to assume that about any operator.
radio = mksafe(radio)
{% endif %}

# -----------------------------------------------------------------------------
#  Now playing
# -----------------------------------------------------------------------------

def json_escape(s) =
  s = string.replace(pattern='\\\\', fun (_) -> '\\\\\\\\', s)
  s = string.replace(pattern='"', fun (_) -> '\\\\"', s)
  s = string.replace(pattern='\n', fun (_) -> ' ', s)
  s = string.replace(pattern='\r', fun (_) -> ' ', s)
  s = string.replace(pattern='\t', fun (_) -> ' ', s)
  s
end

def write_nowplaying(m) =
  artist = m["artist"]
  title = m["title"]
  filename = m["filename"]

  # A file with no tags still has to say something useful, so fall back to
  # its name rather than showing an empty player.
  title = if title == "" then path.remove_extension(path.basename(filename)) else title end

  payload =
    '{"artist": "#{json_escape(artist)}", '
    ^ '"title": "#{json_escape(title)}", '
    ^ '"album": "#{json_escape(m["album"])}", '
    ^ '"filename": "#{json_escape(filename)}", '
    ^ '"bpm": "#{json_escape(m["bpm"])}", '
    ^ '"started_at": #{time()}, '
    ^ '"source": "liquidsoap"}'

  # atomic: the dashboard reads this file constantly and must never catch it
  # half-written.
  #
  # temp_dir is not optional here. Without it Liquidsoap writes the temporary
  # copy under the system temp directory and renames it across file systems —
  # /tmp is a tmpfs and /data is the volume — which cannot be atomic, so the
  # write fails with "Atomic rename failed!" and the dashboard shows no track
  # at all. Keeping the temporary file beside the target makes the rename a
  # rename.
  file.write(
    data=payload,
    atomic=true,
    temp_dir="{{ nowplaying_dir }}",
    "{{ nowplaying_file }}"
  )
end

radio.on_metadata(synchronous=false, write_nowplaying)

# -----------------------------------------------------------------------------
#  Output
# -----------------------------------------------------------------------------

stream_out = output.icecast(
  {% if audio_format == "opus" %}%opus(bitrate={{ bitrate_k }}, samplerate=48000, channels=2){% else %}%mp3(bitrate={{ bitrate_k }}, samplerate=44100, stereo=true){% endif %},
  id="icecast_out",
  host="{{ icecast_host }}",
  port={{ icecast_port }},
  password="{{ icecast_password }}",
  mount="{{ icecast_mount }}",
  name="{{ station_name }}",
  description="{{ station_description }}",
  genre="Trance",
  radio
)

# Icecast may still be starting when we connect, and it may be restarted under
# us later. Never give up: keep retrying, because silence is the one failure
# this station is not allowed to have.
# `error` is a builtin; shadowing it would silently break error handling.
def on_icecast_error(~restart_in, err) =
  log(level=2, "icecast output error: #{err} — retrying in {{ retry_delay }}s")
  restart_in({{ retry_delay }})
end

stream_out.on_error(synchronous=false, on_icecast_error)

{{ extra_config }}
